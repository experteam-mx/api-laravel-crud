{
    "name": "experteam/api-laravel-crud",
    "description": "Library to help with Laravel api CRUDs definition",
    "homepage": "https://github.com/experteam-mx/api-laravel-crud",
    "keywords": [
        "laravel",
        "crud",
        "experteam"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Renán Rivadeneira",
            "email": "renan.rivadeneira@experteam.com.ec",
            "role": "Developer"
        },
        {
            "name": "Iraldo Arevalo",
            "email": "iraldo.arevalo@experteam.com.ec"
        }
    ],
    "require": {
        "php": "^8.3 || ^8.4",
        "ext-json": "*",
        "laravel/framework": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "experteam/api-laravel-base": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Experteam\\ApiLaravelCrud\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Experteam\\ApiLaravelCrud\\ApiLaravelCrudServiceProvider"
            ],
            "aliases": {
                "ApiClient": "Experteam\\ApiLaravelCrud\\Facades\\ApiClientFacade"
            }
        }
    }
}
